# Copy to .env; keep real keys local. No OmniRoute server settings are changed.
LLM_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=replace-me
OMNIROUTE_MODEL=ddgw/gpt-5.4-mini
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_PATH=data/models/embeddinggemma-300m
QDRANT_PATH=data/qdrant-gemma
KB_PATH=Knowledge Base
# Optional Hugging Face download authentication: HF_TOKEN (or use hf auth login).
# Hosted OpenAI fallback requires LLM_PROVIDER=openai and these settings:
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-4.1-mini
# EMBEDDING_BACKEND=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# Use a different QDRANT_PATH whenever embedding configuration changes.
